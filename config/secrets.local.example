# OPAL Secrets Configuration
# Copy this file to secrets.local and fill in your values
# NEVER commit secrets.local to git

# Notion Integration
NOTION_INTEGRATION_TOKEN=secret_xxxxxxxxxxxxx
NOTION_WORKSPACE_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Transcript Sources
OTTER_API_KEY=sk-otter-xxxxxxxxxxxxx
FATHOM_API_KEY=sk-fathom-xxxxxxxxxxxxx
READAI_API_KEY=sk-readai-xxxxxxxxxxxxx

# Telegram Bot
TELEGRAM_BOT_TOKEN=1234567890:XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Google Suite (OAuth credentials JSON path)
GOOGLE_CREDENTIALS=/path/to/credentials.json
